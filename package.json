{
  "name": "orbital-arena",
  "version": "1.0.0",
  "description": "A multiplayer flight-combat game over a living Dutch landscape: capture windmills, dogfight rival villages.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch lib server.js",
    "dev:client": "vite",
    "build": "vite build",
    "vercel-build": "npm run build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-names.mjs && tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "nodemon": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
