# Copy to .env (never commit real keys). All are optional.
# The server reads it with: node --env-file=.env server.js (Vercel uses its own env settings).

# Cloud pilot profiles + leaderboard (server-side only; see supabase/schema.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local development alternative: keep pilot records in a JSON file
# PILOT_STORE_FILE=./data/pilots.json

# Client build: connect to an always-on game server instead of the same origin
# VITE_GAME_SERVER_URL=https://your-game-server.example.com

# Testing: shorter rounds and intermissions
# MATCH_SECONDS=30
# INTERMISSION_SECONDS=5
